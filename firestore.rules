rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // ITM System Collections
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /onboardings/{onboardingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /offboardings/{offboardingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /borrowings/{borrowingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /preventive_maintenance/{pmId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /liabilities/{liabilityId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /activity_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
